{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", ":semanticCommits", ":semanticCommitTypeAll(chore)"],

  timezone: "UTC",
  schedule: ["before 12pm on monday"],
  baseBranchPatterns: ["develop"],

  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  branchConcurrentLimit: 5,

  rebaseWhen: "conflicted",
  rangeStrategy: "bump",

  minimumReleaseAge: "3 days",

  dependencyDashboard: true,
  labels: ["dependencies"],

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["Priority: Critical", "Type: Security", "security"],
    assignees: ["AndryOre"],
  },

  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 12pm on monday"],
    automerge: true,
  },

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^scripts/lighthouse-budget\\.ts$/"],
      matchStrings: ['LIGHTHOUSE_VERSION = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "lighthouse",
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "lychee binary pinned in LYCHEE_VERSION",
      managerFilePatterns: ["/^scripts/lint-documentation\\.ts$/"],
      matchStrings: ['LYCHEE_VERSION = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "lycheeverse/lychee",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^lychee-(?<version>v.+)$",
    },
    {
      customType: "regex",
      description: "Workflow versions annotated with a '# renovate: datasource=<ds> depName=<name>' comment (actionlint, zizmor)",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*[A-Za-z0-9_]*VERSION:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?",
      ],
    },
  ],

  packageRules: [
    {
      matchDepTypes: ["devDependencies"],
      semanticCommitScope: "deps-dev",
    },
    {
      matchDepTypes: ["dependencies"],
      semanticCommitScope: "deps",
    },

    {
      groupName: "astro",
      matchPackageNames: ["astro", "@astrojs/**"],
    },
    {
      groupName: "eslint",
      matchPackageNames: [
        "eslint",
        "@eslint/**",
        "typescript-eslint",
        "eslint-plugin-*",
        "eslint-config-*",
      ],
    },
    {
      groupName: "type definitions",
      matchPackageNames: ["@types/**"],
    },
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
    },

    {
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "7 days",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "minor", "digest", "pin", "pinDigest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "7 days",
    },

    {
      groupName: "oxc",
      matchPackageNames: [
        "oxlint",
        "oxlint-tsgolint",
        "oxlint-plugin-eslint",
        "oxfmt",
        "@oxc-project/**",
        "@oxlint/**",
        "oxc-*",
      ],
      rangeStrategy: "pin",
      automerge: false,
    },
    {
      matchDepNames: ["typescript7", "@astrojs/ts-content-mapper"],
      rangeStrategy: "pin",
      automerge: false,
    },
    {
      matchDepNames: ["typescript"],
      allowedVersions: "<7",
    },
  ],
}
