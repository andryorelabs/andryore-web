{
  "repository": "andryorelabs/andryore-web",
  "settings": {
    "description": "The source of andryore.dev, the personal site of Andry Orellana.",
    "homepage": "https://andryore.dev",
    "defaultBranch": "main",
    "hasWiki": false,
    "hasProjects": false,
    "hasDiscussions": false,
    "allowSquashMerge": true,
    "allowMergeCommit": true,
    "allowRebaseMerge": false,
    "deleteBranchOnMerge": true,
    "allowAutoMerge": true,
    "allowUpdateBranch": true,
    "mergeCommitTitle": "PR_TITLE",
    "mergeCommitMessage": "PR_BODY",
    "squashMergeCommitTitle": "PR_TITLE",
    "squashMergeCommitMessage": "PR_BODY"
  },
  "security": {
    "secretScanning": "enabled",
    "secretScanningPushProtection": "enabled",
    "privateVulnerabilityReporting": true,
    "dependabotAlerts": true,
    "dependabotSecurityUpdates": "enabled",
    "defaultWorkflowPermissions": "read",
    "forkPrApproval": "all_external_contributors",
    "codeqlSetup": "not-configured"
  },
  "topics": ["astro", "personal-website", "portfolio", "typescript", "tailwindcss", "react", "i18n"]
}
