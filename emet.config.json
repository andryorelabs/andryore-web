{
  "$schema": "https://emet.andryore.dev/schema/emet.config.schema.json",
  "version": 1,
  "repo": {
    "trunk": "develop",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^AO-\\d+$",
    "branchPrefix": "ao"
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "linear",
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "automatic",
      "onPrMerge": "automatic"
    },
    "team": "AO"
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": []
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true,
    "afterSpec": "promote"
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "commands": {
    "selfCheck": ["bun run check", "bun run test"]
  },
  "worktree": {
    "bootstrap": ["bun install --frozen-lockfile --silent"]
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "models": {
    "worker": {
      "model": "sonnet",
      "effort": "medium"
    },
    "reviewer": {
      "medium": {
        "model": "opus",
        "effort": "medium"
      },
      "high": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "triage": "haiku",
    "escalation": {
      "sonnet": "opus"
    }
  },
  "language": {
    "conversation": "es",
    "artifacts": "en"
  },
  "verify": {
    "browser": {
      "startCommand": "bun run dev --host 127.0.0.1 --port 4321",
      "url": "http://127.0.0.1:4321",
      "paths": ["src/**", "public/**", "astro.config.mjs"]
    }
  },
  "deploy": {
    "check": {
      "command": "git fetch -q origin main && deployed=$(curl -fsSI https://andryore.dev/ | tr -d '\\r' | sed -n 's/^last-modified: //Ip') && [ -n \"$deployed\" ] && [ \"$(date -d \"$deployed\" +%s)\" -ge \"$(git log -1 --format=%ct origin/main)\" ]",
      "retries": 30,
      "intervalSeconds": 20,
      "timeoutSeconds": 900
    }
  },
  "review": {
    "highRiskPaths": [
      "dockerfile",
      "docker/",
      "csp",
      "src/server/",
      ".env",
      "robots.txt",
      "analytics",
      "astro.config",
      ".github/rulesets/",
      "repo-settings"
    ]
  }
}
